# --- Demo authentication -------------------------------------------------
# These are the credentials shown on the login screen.
DEMO_NAME="Aling Nena"
DEMO_EMAIL="demo@kaintayo.ph"
DEMO_PASSWORD="kain123"
# Long random string used to sign the session cookie.
AUTH_SECRET="change-me-to-a-long-random-string-before-deploying"

# --- App -----------------------------------------------------------------
# Used to build Xendit success/cancel return URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Build output (optional, Windows + OneDrive) ---------------------------
# OneDrive rewrites .next as cloud placeholders, which makes Next.js crash on
# startup with "EINVAL: readlink". Set this to a folder OUTSIDE the OneDrive
# sync root (relative to this project, e.g. one on C:\ that is not synced) to
# move the build output there. Leave it empty to keep the default .next folder.
NEXT_DIST_DIR=""

# --- Supabase ------------------------------------------------------------
# Public project values (safe to expose).
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SERVER ONLY. The sb_secret_... service-role key from
# Project Settings -> API Keys. Required for every write (accounts, dishes,
# orders, payments) because RLS is enabled. Never expose it to the browser:
# no NEXT_PUBLIC_ prefix, no client-side import, no commit.
SUPABASE_SECRET_KEY=""

# --- Xendit (test mode) ---------------------------------------------------
# Secret key from https://dashboard.xendit.co > Settings > Developers > API Keys
# (test keys start with xnd_development_). Leave empty to use the built-in
# local checkout gateway instead of the hosted payment page.
XENDIT_SECRET_KEY=""
# Callback token from Dashboard -> Settings -> Developers -> Callbacks.
XENDIT_CALLBACK_TOKEN=""
# "test" or "live". Test mode is enforced unless this is explicitly "live".
XENDIT_MODE="test"
