# --- Demo authentication -------------------------------------------------
# These are the credentials shown on the login screen.
DEMO_NAME="Aling Nena"
DEMO_EMAIL="demo@kaintayo.ph"
DEMO_PASSWORD="kain123"
# Long random string used to sign the session cookie.
AUTH_SECRET="change-me-to-a-long-random-string-before-deploying"

# --- App -----------------------------------------------------------------
# Used to build PayMongo success/cancel return URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- PayMongo (test mode) ------------------------------------------------
# Copy the secret key from https://dashboard.paymongo.com/developers/api-keys
# Leave empty to run the built-in demo gateway instead of real checkout.
PAYMONGO_SECRET_KEY=""
# Webhook signing secret from Dashboard > Developers > Webhooks.
PAYMONGO_WEBHOOK_SECRET=""
# "test" or "live". Test mode is enforced unless this is explicitly "live".
PAYMONGO_MODE="test"
